# Required process environment. Copy this file to .env.dev and set local values there.
# Do not put secrets in this file.

# PostgreSQL connection URL, for example:
# postgresql://USER:PASSWORD@localhost:5432/dorehami
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=dorehami
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional local overrides. Defaults are suitable for development only.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
